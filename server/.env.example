# server/.env — 이 파일을 .env 로 복사해 고친다. .env 는 git 에 넣지 않는다 (비밀값이 들어간다).
# 이미 있는 환경 변수가 이 파일보다 이긴다.

# 엔진: fake = 합성 세션 (데이터 없이) · real = 분석 엔진 lefdata.api (server 가상환경에 pip install -e ../engine)
LEF_SITE_ENGINE=fake
# real 일 때 읽을 곳 — 비우면 엔진 기본값
# LEF_SESSION_ROOT=
# LEF_DATA_ROOT=

# 서버가 묶일 곳. 1차는 이 PC 에서만 (127.0.0.1)
LEF_SITE_HOST=127.0.0.1
LEF_SITE_PORT=8000
# 브라우저가 여는 주소 — 비우면 http://HOST:PORT. Google 로그인이 돌아올 주소의 앞부분이 된다
# LEF_SITE_PUBLIC_URL=

# 로그인: dev = 개발용 자동 로그인 (127.0.0.1 에서만) · google = Google 로그인 + 명단
LEF_SITE_AUTH=dev
# 개발용 사용자 — 역할을 member 로 바꾸면 팀원 화면을 볼 수 있다
# LEF_SITE_DEV_EMAIL=dev@localhost
# LEF_SITE_DEV_ROLE=admin

# Google 로그인 (LEF_SITE_AUTH=google 일 때) — Google Cloud 콘솔의 OAuth 클라이언트 (웹 애플리케이션)
# 승인된 리디렉션 URI 에 <주소>/auth/google/callback 을 넣는다 (예: http://127.0.0.1:8000/auth/google/callback)
# LEF_SITE_GOOGLE_CLIENT_ID=
# LEF_SITE_GOOGLE_CLIENT_SECRET=
# 받을 메일 도메인 — 토큰의 hd 값과 메일 끝을 둘 다 본다
# LEF_SITE_ALLOWED_DOMAIN=example.ac.kr

# 로그인 쿠키 서명 키 — 비우면 server/.local/secret_key 를 만들어 쓴다. 서버로 옮길 때는 여기에 긴 임의 문자열
# LEF_SITE_SECRET_KEY=
# 앱 DB (명단 · 로그인 기록) — 비우면 server/.local/site.db
# LEF_SITE_DB=
